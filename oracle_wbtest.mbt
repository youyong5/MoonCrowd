///|
test "RVO2 differential 04" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_agent(
    Vec2::new(1.35225, -3.36671),
    velocity=Vec2::new(0.28961, -0.25213),
    config={
      radius: 0.28271,
      max_speed: 1.41082,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 2.78185,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(-0.51273, -1.66938))
  sim.add_agent(
    Vec2::new(-2.28037, 2.90449),
    velocity=Vec2::new(0.03525, -0.07239),
