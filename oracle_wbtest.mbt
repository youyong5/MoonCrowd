///|
test "RVO2 differential 01" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_obstacle([Vec2::new(0.0, -6.0), Vec2::new(0.0, 6.0)]) |> ignore
  sim.add_agent(
    Vec2::new(-4.65046, 3.46583),
    velocity=Vec2::new(-0.06892, 0.26959),
    config={
      radius: 0.15167,
      max_speed: 1.13886,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 2.86932,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(0.46054, 0.28253))
