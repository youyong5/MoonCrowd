///|
test "RVO2 differential 11" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_obstacle([
    Vec2::new(-1.0, -1.0),
    Vec2::new(1.0, -1.0),
    Vec2::new(1.0, 0.0),
    Vec2::new(0.0, 0.0),
    Vec2::new(0.0, 1.0),
    Vec2::new(-1.0, 1.0),
  ])
  |> ignore
  sim.add_agent(
    Vec2::new(2.19819, -0.96526),
    velocity=Vec2::new(-0.11709, -0.11547),
    config={
      radius: 0.20884,
      max_speed: 1.13754,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 3.54216,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(-0.81213, 0.66953))
  sim.add_agent(
    Vec2::new(-3.28977, -0.02566),
    velocity=Vec2::new(0.02897, 0.29132),
    config={
      radius: 0.20686,
      max_speed: 1.63486,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 2.95181,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(1, Vec2::new(-0.44148, 1.09819))
  sim.add_agent(
    Vec2::new(0.67746, 2.04594),
    velocity=Vec2::new(0.13436, 0.06584),
    config={
      radius: 0.33335,
      max_speed: 1.89632,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 2.02781,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(2, Vec2::new(0.3818, -0.07157))
  sim.add_agent(
    Vec2::new(-0.39462, -2.42054),
    velocity=Vec2::new(0.17646, -0.16989),
    config={
      radius: 0.22173,
      max_speed: 1.57089,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 3.25245,
