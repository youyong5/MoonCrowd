///|
test "RVO2 differential 22" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_obstacle([
    Vec2::new(-1.0, -1.0),
    Vec2::new(1.0, -1.0),
    Vec2::new(1.0, 1.0),
    Vec2::new(-1.0, 1.0),
  ])
  |> ignore
  sim.add_agent(
    Vec2::new(-0.49901, 4.39826),
    velocity=Vec2::new(0.24467, 0.06254),
    config={
      radius: 0.16207,
      max_speed: 1.58609,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 1.53194,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(-0.74308, -0.41543))
  sim.add_agent(
    Vec2::new(-4.15499, 4.55691),
    velocity=Vec2::new(0.2818, 0.25226),
    config={
      radius: 0.29285,
      max_speed: 1.27141,
