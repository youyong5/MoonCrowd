///|
test "RVO2 differential 02" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_obstacle([
    Vec2::new(-1.0, -1.0),
    Vec2::new(1.0, -1.0),
    Vec2::new(1.0, 1.0),
    Vec2::new(-1.0, 1.0),
  ])
  |> ignore
  sim.add_agent(
    Vec2::new(3.37269, 3.21204),
    velocity=Vec2::new(0.14243, -0.0881),
    config={
      radius: 0.33051,
      max_speed: 1.59191,
      neighbor_distance: 7.0,
      max_neighbors: 16,
      time_horizon: 3.98428,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(0.09954, 1.09335))
  sim.add_agent(
    Vec2::new(-2.15458, 0.49421),
    velocity=Vec2::new(-0.27904, -0.02253),
