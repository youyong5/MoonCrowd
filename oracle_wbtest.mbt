///|
test "RVO2 differential 18" {
  let sim = Simulator::new(time_step=0.05)
  sim.add_obstacle([
    Vec2::new(-1.0, -1.0),
    Vec2::new(1.0, -1.0),
    Vec2::new(1.0, 1.0),
    Vec2::new(-1.0, 1.0),
  ])
  |> ignore
  sim.add_agent(
    Vec2::new(3.28459, 3.73773),
    velocity=Vec2::new(0.29962, -0.10236),
    config={
      radius: 0.19617,
      max_speed: 1.00161,
      neighbor_distance: 7.0,
      max_neighbors: 3,
      time_horizon: 2.36008,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(0, Vec2::new(-1.59716, 0.97494))
  sim.add_agent(
    Vec2::new(3.01869, 1.94186),
    velocity=Vec2::new(0.24539, 0.20887),
    config={
      radius: 0.3034,
      max_speed: 1.03998,
      neighbor_distance: 7.0,
      max_neighbors: 3,
      time_horizon: 1.90549,
      obstacle_horizon: 3.0,
    },
  )
  |> ignore
  sim.set_preferred_velocity(1, Vec2::new(-0.22428, 1.07517))
  sim.add_agent(
    Vec2::new(-2.12442, -4.90859),
    velocity=Vec2::new(0.22394, 0.03223),
    config={
      radius: 0.34182,
      max_speed: 1.2091,
      neighbor_distance: 7.0,
      max_neighbors: 3,
      time_horizon: 3.64872,
